    "nlud_code": {
      "originalName": "NLUD_code",
      "description": "An alternative land use classification that uses a code defined in the National Land Use Database schema. Populated in the first instance from the land use of the largest Land Use Site (if any) that the feature lies within, and if that does not apply, then by any land use implicit in the nature of the feature itself.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4
    },
    "nlud_orderdescription": {
      "originalName": "NLUD_orderDescription",
      "description": "A description of the highest (least detailed) level of an alternative land use classification as defined in the National Land Use Database schema. Populated in the first instance from the land use of the largest Land Use Site (if any) that the feature lies within, and if that does not apply, then by any land use implicit in the nature of the feature itself.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30
    },
    "nlud_groupdescription": {
      "originalName": "NLUD_groupDescription",
      "description": "A description of the second level of an alternative land use classification as defined in the National Land Use Database schema. Populated in the first instance from the land use of the largest Land Use Site (if any) that the feature lies within, and if that does not apply, then by any land use implicit in the nature of the feature itself.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "address_classificationcode": {
      "originalName": "address_classificationCode",
      "description": "An alternative land use classification that uses a code defined in the Address/BS7666 schema. Populated only where local authority address information lies within a Land Use Site that the feature also falls within. The value is derived by analysis of the attribution of Address information that falls within the extent of the smallest Land Use Site that the feature lies within.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2
    },
    "address_primarydescription": {
      "originalName": "address_primaryDescription",
      "description": "The description of the highest (least detailed) level of an alternative land use classification as defined in the Address/BS7666 schema. Populated only where local authority address information lies within a Land Use Site that the feature also falls within. The value is derived by analysis of the attribution of Address information that falls within the extent of the smallest Land Use Site that the feature lies within.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "address_secondarydescription": {
      "originalName": "address_secondaryDescription",
      "description": "The description of the second level of an alternative land use classification as defined in the Address/BS7666 schema. Populated only where local authority address information lies within a Land Use Site that the feature also falls within. The value is derived by analysis of the attribution of Address information that falls within the extent of the smallest Land Use Site that the feature lies within.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "lowertierlocalauthority_gsscode": {
      "originalName": "lowerTierLocalAuthority_gssCode",
      "description": "The unique identifier of the Lower Tier Local Authority administrative area provided by the Office for National Statistics that the Topographic feature lies within. Where a Topographic area falls into more than one Lower Tier Local Authority, then it will be assigned to the Lower Tier Local Authority that the majority of its area lies within. Where a Topographic area falls outside any Lower Tier Local Authority (for example, an offshore feature), then no code will be provided.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10
    },
    "lowertierlocalauthority_count": {
      "originalName": "lowerTierLocalAuthority_count",
      "description": "The total number of Lower Tier Local Authority administrative areas the feature lies within.",
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "originalName": "status",
      "description": "The state of the feature in relation to either its physical condition or the activity the feature is intended to support. ",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "enum": [
        "Active",
        "Derelict",
        "Inactive",
        "Under Construction",
        "Unknown"
      ]
    },
    "status_updatedate": {
      "originalName": "status_updateDate",
      "description": "Date when the attribute was last updated.",
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "habitatcoveragereference": {
      "originalName": "habitatCoverageReference",
      "description": "The habitat classification schemes (European Nature Information System (EUNIS) and UK Biodiversity Action Plan (BAP) Broad Habitats) with the percentage of each land cover classification within a topographic area.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "osid": {
            "originalName": "OSID",
            "description": "Primary feature identifier of the feature reference.",
            "type": "string",
            "format": "uuid",
            "maxLength": 36
          },
          "scheme": {
            "originalName": "scheme",
            "description": "Classification scheme name.",
            "type": "string",
            "maxLength": 20
          },
          "habitatcode": {
            "originalName": "habitatCode",
            "description": "Habitat classification code for EUNIS Level 1 and EUNIS Level 2 only, where a direct mapping is possible to the OS Land Cover Tier B classification value. This is blank for OS Land Cover Tier B and UK BAP Broad Habitat.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5
          },
          "habitatdescription": {
            "originalName": "habitatDescription",
            "description": "Habitat classification description. EUNIS Level 2 and UK BAP Broad Habitat descriptions are populated where a direct mapping is possible to the OS Land Cover Tier B classification value.",
            "type": "string",
            "maxLength": 80
          },
          "percentage": {
            "originalName": "percentage",
            "description": "Numerical value of the calculated percentage of each classification within a single topographic area.",
            "type": [
              "integer",
              "null"
            ]
          },
          "percentage_evidencedate": {
            "originalName": "percentage_evidenceDate",
            "description": "The date on which the latest evidence was gathered to make an update to the percentage value, if required.",
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "percentage_updatedate": {
            "originalName": "percentage_updateDate",
            "description": "Date the percentage attribute was last updated.",
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "featuretypeversiondate": {
            "originalName": "featureTypeVersionDate",
            "description": "Date of the latest Land feature version.",
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "sitereference": {
      "originalName": "SiteReference",
      "description": "This attribute holds the cross reference table between the feature type and Site.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "siteid": {
            "originalName": "siteID",
            "description": "The identifier for the Site feature.",
